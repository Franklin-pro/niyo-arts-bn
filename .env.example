NODE_ENV=development
PORT=4000

# Option A: use DATABASE_URL
# DATABASE_URL=postgres://postgres:your_password@localhost:5432/niyo_arts

# Option B: use separate PostgreSQL settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=niyo_arts
DB_USER=postgres
DB_PASSWORD=change_me

CORS_ORIGIN=http://localhost:3000
# Set to the number of trusted reverse-proxy hops in production (commonly 1).
# TRUST_PROXY_HOPS=1
JWT_SECRET=replace_with_a_long_random_secret
FRONTEND_URL=http://localhost:3000
# Public backend origin Flutterwave can reach; use your tunnel URL during local testing.
API_BASE_URL=http://localhost:4000

# Admin account is created on startup when both values are set.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# SMTP order, contact, and password-reset email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=Niyo Arts <orders@example.com>
CONTACT_TO=admin@example.com
# Optional comma-separated order notification recipients (the admin email is also included).
# ORDER_NOTIFICATION_EMAILS=orders@example.com,operations@example.com
# Optional public HTTPS logo displayed in order emails.
# BRAND_LOGO_URL=https://example.com/logo.png
# Optional shipping prices by destination country and currency; missing rates are zero.
# SHIPPING_RATES_JSON={"RW":{"RWF":5000},"DEFAULT":{"USD":25,"RWF":10000}}

# Flutterwave test/live credentials; never expose these in frontend code.
FLW_SECRET_KEY=FLWSECK_TEST-replace_me
FLW_SECRET_HASH=replace_with_webhook_secret_hash

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# CLOUDINARY_FOLDER=niyo-arts
